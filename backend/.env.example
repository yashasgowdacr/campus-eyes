PORT=5000

# Option A: Cloud Neon PostgreSQL (Recommended for production on Render)
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Local MySQL (Default when DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_complaints
DB_PORT=3306

# Optional: OpenAI API Key (Built-in offline NLP engine runs by default with $0 cost)
OPENAI_API_KEY=
